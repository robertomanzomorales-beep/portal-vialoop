generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  COLLABORATOR
  CLIENT
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
  FINISHED
}

enum ProjectStatus {
  DEVELOPMENT
  ACTIVE
  MAINTENANCE
  SUSPENDED
  FINISHED
}

enum PlanType {
  ESSENTIAL
  MANAGEMENT
  ACTIVE
  CUSTOM
}

enum BillingCycle {
  MONTHLY
  SEMIANNUAL
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportStatus {
  RECEIVED
  UNDER_REVIEW
  WAITING_FOR_CLIENT
  APPROVED
  IN_PROGRESS
  READY_FOR_REVIEW
  COMPLETED
  REJECTED
  OUT_OF_SCOPE
}

enum DocumentType {
  CONTRACT
  QUOTATION
  INVOICE
  PAYMENT_RECEIPT
  REPORT
  MANUAL
  LOGO
  TEXT
  IMAGE
  BACKUP
  TECHNICAL
  OTHER
}

enum RenewalType {
  DOMAIN
  HOSTING
  EMAIL
  SSL
  SUBSCRIPTION
  ADDITIONAL_SERVICE
}

enum RenewalStatus {
  UPCOMING
  NOTIFIED
  PAID
  RENEWED
  EXPIRED
  CANCELLED
}

enum RenewalReminderType {
  FIRST_NOTICE
  SECOND_NOTICE
  FINAL_NOTICE
  OVERDUE_NOTICE
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  CASH
  OTHER
}

enum FlowOrderStatus {
  PENDING
  PAID
  REJECTED
  CANCELLED
  ERROR
}

model User {
  id               String           @id @default(cuid())
  name             String
  email            String           @unique
  passwordHash     String?
  role             UserRole         @default(CLIENT)
  active           Boolean          @default(true)
  clientId         String?
  client           Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedRequests SupportRequest[] @relation("AssignedSupportRequests")
  createdRequests  SupportRequest[] @relation("CreatedSupportRequests")
  activityLogs     ActivityLog[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([clientId])
  @@index([role])
}

model Client {
  id              String           @id @default(cuid())
  businessName    String
  tradeName       String?
  rut             String?          @unique
  mainContactName String?
  email           String?
  phone           String?
  city            String?
  address         String?
  status          ClientStatus     @default(ACTIVE)
  joinedAt        DateTime         @default(now())
  internalNotes   String?
  users           User[]
  projects        Project[]
  subscriptions   Subscription[]
  supportRequests SupportRequest[]
  documents       Document[]
  renewals        Renewal[]
  payments        Payment[]
  activityLogs    ActivityLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([businessName])
}

model Project {
  id                 String           @id @default(cuid())
  clientId           String
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String
  domain             String?
  websiteUrl         String?
  websiteType        String?
  technology         String?
  hostingProvider    String?
  hostingCapacity    String?
  publicationDate    DateTime?
  domainRenewalDate  DateTime?
  hostingRenewalDate DateTime?
  formRecipientEmail String?
  status             ProjectStatus    @default(DEVELOPMENT)
  notes              String?
  supportRequests    SupportRequest[]
  documents          Document[]
  renewals           Renewal[]
  subscriptions      Subscription[]
  activityLogs       ActivityLog[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([domain])
}

model Plan {
  id               String         @id @default(cuid())
  name             String
  type             PlanType       @unique
  monthlyPrice     Decimal        @db.Decimal(12, 2)
  includedRequests Int            @default(0)
  responseHours    Int?
  description      String?
  active           Boolean        @default(true)
  subscriptions    Subscription[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Subscription {
  id           String             @id @default(cuid())
  clientId     String
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  status       SubscriptionStatus @default(ACTIVE)
  billingCycle BillingCycle       @default(MONTHLY)
  agreedPrice  Decimal            @db.Decimal(12, 2)
  requestsUsed Int                @default(0)
  startsAt     DateTime
  renewsAt     DateTime?
  endsAt       DateTime?
  notes        String?
  payments     Payment[]
  renewals     Renewal[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([planId])
  @@index([status])
  @@index([renewsAt])
}

model SupportRequest {
  id                String              @id @default(cuid())
  number            Int                 @unique @default(autoincrement())
  clientId          String
  client            Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?               @relation("CreatedSupportRequests", fields: [createdById], references: [id], onDelete: SetNull)
  assignedToId      String?
  assignedTo        User?               @relation("AssignedSupportRequests", fields: [assignedToId], references: [id], onDelete: SetNull)
  subject           String
  description       String
  priority          SupportPriority     @default(NORMAL)
  status            SupportStatus       @default(RECEIVED)
  estimatedDelivery DateTime?
  completedAt       DateTime?
  internalNotes     String?
  attachments       SupportAttachment[]
  comments          SupportComment[]
  activityLogs      ActivityLog[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model SupportAttachment {
  id               String         @id @default(cuid())
  supportRequestId String
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  mimeType         String?
  fileSize         Int?
  createdAt        DateTime       @default(now())

  @@index([supportRequestId])
}

model SupportComment {
  id               String         @id @default(cuid())
  supportRequestId String
  supportRequest   SupportRequest @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  authorName       String
  authorType       UserRole
  message          String
  internal         Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@index([supportRequestId])
}

model Document {
  id              String       @id @default(cuid())
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name            String
  type            DocumentType @default(OTHER)
  fileUrl         String
  mimeType        String?
  fileSize        Int?
  description     String?
  visibleToClient Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([type])
}

model Renewal {
  id             String                @id @default(cuid())
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  type           RenewalType
  description    String
  dueDate        DateTime
  amount         Decimal?              @db.Decimal(12, 2)
  status         RenewalStatus         @default(UPCOMING)
  notifiedAt     DateTime?
  renewedAt      DateTime?
  notes          String?
  notifications  RenewalNotification[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([subscriptionId])
  @@index([dueDate])
  @@index([status])
}

model RenewalNotification {
  id        String              @id @default(cuid())
  renewalId String
  renewal   Renewal             @relation(fields: [renewalId], references: [id], onDelete: Cascade)
  type      RenewalReminderType
  recipient String
  subject   String
  body      String              @db.Text
  sentOn    DateTime            @db.Date
  sentAt    DateTime            @default(now())

  @@unique([renewalId, type, sentOn])
  @@index([renewalId])
  @@index([type])
  @@index([sentAt])
}

model Payment {
  id             String         @id @default(cuid())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  description    String
  amount         Decimal        @db.Decimal(12, 2)
  dueDate        DateTime?
  paidAt         DateTime?
  status         PaymentStatus  @default(PENDING)
  method         PaymentMethod?
  reference      String?
  notes          String?
  flowOrders     FlowOrder[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([clientId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

model FlowOrder {
  id            String          @id @default(cuid())
  paymentId     String
  payment       Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  commerceOrder String          @unique
  flowOrder     Int?            @unique
  token         String?         @unique
  paymentUrl    String?
  status        FlowOrderStatus @default(PENDING)
  amount        Decimal         @db.Decimal(12, 2)
  payerEmail    String
  subject       String
  rawResponse   Json?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

model ActivityLog {
  id               String          @id @default(cuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId         String?
  client           Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  supportRequestId String?
  supportRequest   SupportRequest? @relation(fields: [supportRequestId], references: [id], onDelete: SetNull)
  action           String
  entityType       String
  entityId         String?
  description      String?
  metadata         Json?
  createdAt        DateTime        @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([projectId])
  @@index([supportRequestId])
  @@index([createdAt])
}